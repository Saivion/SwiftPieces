{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swiftpieces",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "swiftpieces" }],
  // Per-IP budgets per minute. The view counter's write path, then the rest of the API.
  "ratelimits": [
    { "name": "VIEWS_LIMITER", "namespace_id": "4301", "simple": { "limit": 20, "period": 60 } },
    // Every other public endpoint: MCP, the registry and the CLI's /r paths (middleware.ts).
    { "name": "API_LIMITER", "namespace_id": "4302", "simple": { "limit": 60, "period": 60 } },
    // Docs search queries as you type, so it gets a larger budget than the rest of the API.
    { "name": "SEARCH_LIMITER", "namespace_id": "4303", "simple": { "limit": 120, "period": 60 } }
  ],
  // Free has no database and no private bucket (Rev 3 §2). Only public media + the ISR cache.
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "swiftpieces-cache" }
  ],
  // Page views. Analytics Engine takes every view (non-blocking, no per-key write ceiling); KV
  // holds the running total, because Analytics Engine only keeps three months (lib/views.ts).
  "analytics_engine_datasets": [
    { "binding": "VIEWS_AE", "dataset": "swiftpieces_views" },
    // Playground product events (app/api/events): names and small enums, never project content.
    { "binding": "BUILDER_AE", "dataset": "swiftpieces_builder" }
  ],
  "kv_namespaces": [
    { "binding": "VIEWS", "id": "582df8ae584143c8bf2d899eeac92fda" }
  ]
}
