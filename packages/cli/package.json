{
  "name": "swiftpieces",
  "version": "0.4.1",
  "description": "CLI for SwiftPieces, a free SwiftUI component library. Copies Swift files into your Xcode project (npx swiftpieces add). No package dependency. MCP for Cursor and Claude Code.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": { "swiftpieces": "./dist/index.js" },
  "files": ["dist", "LICENSE", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "dev": "tsx src/index.ts",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": { "node": ">=18.17" },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "homepage": "https://swiftpieces.com",
  "bugs": { "url": "https://github.com/saivion/swiftpieces/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/saivion/swiftpieces.git", "directory": "packages/cli" },
  "keywords": ["swiftui", "swift", "ios", "ios-26", "components", "component-library", "liquid-glass", "metal", "xcode", "cli", "mcp", "copy-paste"]
}
